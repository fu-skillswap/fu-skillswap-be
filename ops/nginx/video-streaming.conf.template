# Internal/System template. Render the upstream hostname and keep this route
# on the same VPS/reverse proxy that serves the application.
# Spring authorizes the short-lived token; Nginx proxies the actual bytes.

resolver 1.1.1.1 1.0.0.1 valid=300s ipv6=off;

location ~ ^/stream/videos/(?<video_asset_id>[0-9a-fA-F-]{36})\.mp4$ {
    auth_request /_internal_video_authorize;
    auth_request_set $video_source_url $upstream_http_x_video_source_url;
    auth_request_set $video_source_host $upstream_http_x_video_source_host;
    auth_request_set $video_content_type $upstream_http_x_video_content_type;

    # Preserve browser seeking and let the upstream return 206 responses.
    proxy_http_version 1.1;
    proxy_set_header Range $http_range;
    proxy_set_header If-Range $http_if_range;
    proxy_set_header Host $video_source_host;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Accept-Encoding "identity";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_intercept_errors off;

    # The R2 object is private and the playback grant is short-lived. Never
    # let a shared cache retain either the bytes or provider cache directives.
    proxy_hide_header Cache-Control;
    proxy_hide_header Expires;
    proxy_hide_header Content-Type;
    add_header Cache-Control "private, no-store, max-age=0" always;
    add_header Accept-Ranges "bytes" always;
    add_header Content-Type $video_content_type always;
    add_header X-Content-Type-Options "nosniff" always;
    proxy_pass $video_source_url;
}

location = /_internal_video_authorize {
    internal;
    proxy_pass http://spring-backend:8080/api/internal/video-streaming/authorize;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Video-Asset-Id $video_asset_id;
    proxy_set_header X-Video-Token $arg_token;
}
